# Containerfile — Multi-stage build for 42 Web UI
#
# Stages:
#   fortytwo-base         — Ubuntu with build tools, 42 cloned from git
#   fortytwo-build-wasm   — Emscripten SDK, compiles 42 to WASM
#   fortytwo-build-native — Compiles 42 natively
#   fortytwo-web-wasm     — Node.js serving WASM artifacts   (42-web-wasm   :8042)
#   fortytwo-web-server   — Native 42 + Node.js server       (42-web-server :8043)
#
# Usage:
#   cd containers/web
#   docker compose build
#   docker compose up -d 42-web-wasm      # WASM on :8042
#   docker compose up -d 42-web-server    # Native on :8043

ARG EMSDK_VERSION=3.1.61
ARG GIT_URL=https://github.com/ericstoneking/42.git
ARG GIT_BRANCH=master

###############################################################################
FROM ubuntu:26.04 AS fortytwo-base
###############################################################################

SHELL ["/bin/bash", "-c"]

ARG GIT_URL
ARG GIT_BRANCH

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        ca-certificates \
        python3 \
    && rm -rf /var/lib/apt/lists/*

# Install Task (go-task) build automation
RUN sh -c "$(curl --location https://taskfile.dev/install.sh)" -- -d -b /usr/local/bin

# Clone 42 from git
RUN git clone --depth 1 -b ${GIT_BRANCH} ${GIT_URL} /42

WORKDIR /42

###############################################################################
FROM fortytwo-base AS fortytwo-build-wasm
###############################################################################

ARG EMSDK_VERSION

# Install Emscripten SDK (cached independently of build context changes)
ENV EMSDK=/opt/emsdk
RUN git clone https://github.com/emscripten-core/emsdk.git ${EMSDK} \
    && cd ${EMSDK} \
    && ./emsdk install ${EMSDK_VERSION} \
    && ./emsdk activate ${EMSDK_VERSION}
ENV PATH="${EMSDK}:${EMSDK}/upstream/emscripten:${PATH}"

# Install Node.js 24 for build tools and server
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Copy build context AFTER tool installs (changes here won't bust emsdk cache)
COPY . /42/containers/web

# Apply build-time source overrides (overlay custom patches over upstream 42)
# Uses find to skip dotfiles (.gitkeep) and only copy real source files
RUN if [ -d /42/containers/web/42/Source ] \
    && [ -n "$(find /42/containers/web/42/Source -maxdepth 1 -name '*.c' -o -name '*.h' 2>/dev/null | head -1)" ]; then \
       cp -rv /42/containers/web/42/Source/*.c /42/containers/web/42/Source/*.h /42/Source/ 2>/dev/null || true ; \
    fi

# Build 42 as WASM
RUN cd /42/containers/web/wasm && bash build.sh

# Copy shared UI source files into the output directory
RUN cp -r /42/containers/web/ui /42/containers/web/wasm/out/ui

# Record git commit for /version endpoint
RUN cd /42 && git rev-parse --short HEAD > /42/containers/web/wasm/out/.git-commit 2>/dev/null || echo "unknown" > /42/containers/web/wasm/out/.git-commit

###############################################################################
FROM fortytwo-base AS fortytwo-build-native
###############################################################################

# Copy build context (server.js, UI files needed in final image)
COPY . /42/containers/web

# Apply build-time source overrides (overlay custom patches over upstream 42)
RUN if [ -d /42/containers/web/42/Source ] \
    && [ -n "$(find /42/containers/web/42/Source -maxdepth 1 -name '*.c' -o -name '*.h' 2>/dev/null | head -1)" ]; then \
       cp -rv /42/containers/web/42/Source/*.c /42/containers/web/42/Source/*.h /42/Source/ 2>/dev/null || true ; \
    fi

# Build 42 natively without GUI (headless server mode)
# GUIFLAG= disables OpenGL/GLUT linking — no GL libraries needed
RUN cd /42 && make GUIFLAG=

# Record git commit
RUN cd /42 && git rev-parse --short HEAD > /42/.git-commit 2>/dev/null || echo "unknown" > /42/.git-commit

###############################################################################
FROM node:24-slim AS fortytwo-web-wasm
###############################################################################
# WASM: simulation runs in the browser, server just serves files

ENV PORT=8042
ENV ROOT_DIR=/app
ENV SESSION_DIR=/data/sessions
ENV DEFAULTS_DIR=/app/defaults/InOut

# Default InOut/ files for populating new sessions
COPY --from=fortytwo-build-wasm /42/InOut /app/defaults/InOut

COPY --from=fortytwo-build-wasm /42/containers/web/wasm/out /app
COPY --from=fortytwo-build-wasm /42/containers/web/wasm/server.js /app/server.js

# Mount point for per-session directories
RUN mkdir -p /data/sessions

WORKDIR /app
EXPOSE 8042

CMD ["node", "server.js"]

###############################################################################
FROM ubuntu:26.04 AS fortytwo-web-server
###############################################################################
# Native: simulation runs server-side (headless), web UI is a thin client.
# Uses Ubuntu (same as build stage) to match glibc version.

SHELL ["/bin/bash", "-c"]

ENV PORT=8043
ENV ROOT_DIR=/app
ENV INOUT_DIR=/app/InOut
ENV MODEL_DIR=/app/Model
ENV WORLD_DIR=/app/World
ENV BIN_42=/app/42

# Install Node.js 24
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# 42 binary (headless, no GUI)
# InOut/ and Model/ are bind-mounted from the host at runtime
COPY --from=fortytwo-build-native /42/42 /app/42
COPY --from=fortytwo-build-native /42/.git-commit /app/.git-commit

# Server
COPY --from=fortytwo-build-native /42/containers/web/server/server.js /app/server.js

# UI (shared with WASM variant)
COPY --from=fortytwo-build-native /42/containers/web/ui /app/ui

WORKDIR /app
EXPOSE 8043

CMD ["node", "server.js"]
